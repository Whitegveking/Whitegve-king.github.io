d4-2a4339f74d1e' />\n\n<img width='615' height='33' alt='Image' src='https://github.com/user-attachments/assets/cdba82d5-e6ae-42d9-8f4f-0c183eb35337' />\n\n# 1\u3001\u4e0b\u8f7dIDEA\n\n<img width='2081' height='1311' alt='Image' src='https://github.com/user-attachments/assets/16853f9e-fa2a-42a1-b093-4d21142629aa' />\n\n# 2\u3001\u7b80\u5355\u7f16\u5199\u4e86\u4ee3\u7801 HelloWorld\n\n\u6ca1\u60f3\u5230\u65f6\u9694\u5feb\u56db\u5e74\u4e86\u53c8\u5f00\u59cb\u5199\u8d77\u6765\u4e86\u201cHelloWorld\u201d\u3002", "top": 0, "createdAt": 1784856272, "style": "", "script": "<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script>", "head": "", "ogImage": "https://avatars.githubusercontent.com/u/165184260?v=4&size=64", "createdDate": "2026-07-24", "dateLabelColor": "#1f883d"}, "P2": {"htmlDir": "docs/post/JAVA-cong-zi-mian-liang-dao-yun-suan-fu-\uff08-ji-chu-yu-fa-pian-\uff09.html", "labels": ["documentation"], "postTitle": "JAVA\u4ece\u5b57\u9762\u91cf\u5230\u8fd0\u7b97\u7b26\uff08\u57fa\u7840\u8bed\u6cd5\u7bc7\uff09", "postUrl": "post/JAVA-cong-zi-mian-liang-dao-yun-suan-fu-%EF%BC%88-ji-chu-yu-fa-pian-%EF%BC%89.html", "postSourceUrl": "https://github.com/Whitegveking/Whitegve-king.github.io/issues/2", "commentNum": 0, "wordCount": 7511, "description": "# 0\u3001\u5b57\u9762\u91cf\n\n\u8868\u793a\u6570\u636e\u5728\u7a0b\u5e8f\u4e2d\u600e\u4e48\u5199\u3002", "top": 0, "createdAt": 1785141192, "style": "", "script": "<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script>", "head": "", "ogImage": "https://avatars.githubusercontent.com/u/165184260?v=4&size=64", "createdDate": "2026-07-27", "dateLabelColor": "#1f883d"}, "P3": {"htmlDir": "docs/post/if\u3001-xuan-ze-\u3001-xun-huan-yu-ju-he-shu-zu-\uff08-gan-jue-yu-fa-he-C++-huan-zhen-cha-bu-duo-\uff0c-jiu-shi-you-yi-xie-xi-jie-fang-mian-de-wen-ti-xu-yao-zhu-yi-\uff09.html", "labels": ["documentation"], "postTitle": "if\u3001\u9009\u62e9\u3001\u5faa\u73af\u8bed\u53e5\u548c\u6570\u7ec4\uff08\u611f\u89c9\u8bed\u6cd5\u548cC++\u8fd8\u771f\u5dee\u4e0d\u591a\uff0c\u5c31\u662f\u6709\u4e00\u4e9b\u7ec6\u8282\u65b9\u9762\u7684\u95ee\u9898\u9700\u8981\u6ce8\u610f\uff09", "postUrl": "post/if%E3%80%81-xuan-ze-%E3%80%81-xun-huan-yu-ju-he-shu-zu-%EF%BC%88-gan-jue-yu-fa-he-C%2B%2B-huan-zhen-cha-bu-duo-%EF%BC%8C-jiu-shi-you-yi-xie-xi-jie-fang-mian-de-wen-ti-xu-yao-zhu-yi-%EF%BC%89.html", "postSourceUrl": "https://github.com/Whitegveking/Whitegve-king.github.io/issues/3", "commentNum": 0, "wordCount": 5768, "description": "# 1\u3001\u5224\u65ad\u8bed\u53e5\uff08if\uff09\n\n## \u5224\u65ad\u8bed\u53e5\u7684\u7ec6\u8282\n\n1. **if\u8bed\u53e5\u5927\u62ec\u53f7\u7684\u4f4d\u7f6e**\uff1a\u91c7\u7528\u7d27\u51d1\u98ce\u683c\t\n2. **if\u8bed\u53e5\u5927\u62ec\u53f7\u7684\u7701\u7565**\uff1a\u5927\u62ec\u53f7\u4e2d\u53ea\u6709\u4e00\u884c\u8bed\u53e5\u53ef\u7701\u7565\u5927\u62ec\u53f7\n3. **\u5c0f\u62ec\u53f7\u540e\u4e0d\u80fd\u6709\u5206\u53f7**\uff1a\u4f1a\u65ad\u5f00if\u8bed\u53e5\u7ed3\u6784\n4. **\u5224\u65ad\u5e03\u5c14\u7c7b\u578b\u7684\u53d8\u91cf**\uff1a\u76f4\u63a5\u628a\u53d8\u91cf\u5199\u5728\u5c0f\u62ec\u53f7\u4e2d\u5373\u53ef\n\n## \u8bed\u6cd5\u683c\u5f0f\n\n```java\nif(\u5173\u7cfb\u8868\u8fbe\u5f0f){\n    \u8bed\u53e5\u4f53;\n}\n```\n\n## \u4f7f\u7528\u573a\u666f\n\n\u5224\u65ad\u4ee3\u7801\u662f\u5426\u6ee1\u8db3\u6267\u884c\u7684\u6761\u4ef6\n\n# 2\u3001\u9009\u62e9\u8bed\u53e5\uff08switch\uff09\n\n## 1\u3001`default`\u7684\u4f4d\u7f6e\u548c\u7701\u7565\n\n**\u4f4d\u7f6e\uff1a**`case`\u548c`default`\u7684\u4f4d\u7f6e\u53ef\u4ee5\u4efb\u610f\u4e66\u5199\uff0c\u4e00\u822c\u6765\u8bb2,`case`\u4ece\u5c0f\u5230\u5927\u4f9d\u6b21\u4e66\u5199\uff0c`default`\u5199\u5728\u6700\u4e0b\u9762\n\n**\u7701\u7565\uff1a**`default`\u53ef\u4ee5\u7701\u7565\uff0c\u4f46\u5982\u679c\u6240\u6709\u7684case\u90fd\u4e0d\u5339\u914d\u5219\u6ca1\u6709\u4efb\u4f55\u7684\u8f93\u51fa\u7ed3\u679c\n\n## 2\u3001`case`\u7a7f\u900f\n\n**\u6267\u884c\u6d41\u7a0b:**\n\n1. \u62ff\u7740\u5c0f\u62ec\u53f7\u4e2d\u8868\u8fbe\u5f0f\u7684\u503c\u8ddf\u4e0b\u9762\u7684case\u8fdb\u884c\u5339\u914d\n2. \u5982\u679c\u5339\u914d\u4e0a\u4e86\uff0c\u5c31\u4f1a\u6267\u884ccase\u91cc\u9762\u7684\u8bed\u53e5\u4f53\uff0c\u9047\u5230break\u7ed3\u675f\u6574\u4e2a\u7684switch(\u6b63\u5e38\u60c5\u51b5)\n3. \u5982\u679c\u5728\u6267\u884c\u8bed\u53e5\u4f53\u7684\u65f6\u5019\u6ca1\u6709\u770b\u5230break\uff0c\u90a3\u4e48\u7a0b\u5e8f\u4f1a\u7ee7\u7eed\u6267\u884c\u4e0b\u4e00\u4e2acase\u7684\u8bed\u53e5\u4f53\uff0c\u771f\u5230\u9047\u5230break\u6216\u8005\u8fd0\u884c\u5b8c\u6574\u4e2a\u7684switch\u4e3a\u6b62\n\n**\u5e94\u7528\u573a\u666f**\n\n```java\npackage judge;\n\npublic class SwitchDemo1\n{\n    static void main()\n    {\n        // \u5224\u65ad\u5b63\u8282\n        int month = 5;\n        switch (month) {\n            case 3:\n            case 4:\n            case 5:\n                System.out.println('\u6625\u5b63');\n                break;\n            case 6:\n            case 7:\n            case 8:\n                System.out.println('\u590f\u5b63');\n                break;\n            case 9:\n            case 10:\n            case 11:\n                System.out.println('\u79cb\u5b63');\n                break;\n            case 12:\n            case 1:\n            case 2:\n                System.out.println('\u51ac\u5b63');\n                break;\n            default:\n                System.out.println('\u6708\u4efd\u8f93\u5165\u9519\u8bef!');\n                break;\n        }\n    }\n}\n```\n\n**`switch`\u65b0\u7279\u6027**\n\n1. \u7bad\u5934\u6807\u7b7e\n2. case\u540e\u9762\u53ef\u4ee5\u5199\u591a\u4e2a\u503c\n3. switch\u53ef\u4ee5\u6709\u8fd0\u884c\u7ed3\u679c\n4. yield\u5173\u952e\u5b57\n\n```java\npackage judge;\n\npublic class SwitchDemo2\n{\n    static void main()\n    {\n        int number = 3;\n\n        switch (number) {\n            case 1 -> System.out.println('-');\n            case 2 -> System.out.println('\u4e8c');\n            case 3 -> System.out.println('\u4e09');\n            default -> System.out.println('\u6ca1\u6709\u8fd9\u4e2a\u661f\u671f');\n        }\n\n        int a = 10;\n        int b = 10;\n\n        String operator = '+';\n        int result = switch (operator) {\n            case '+' -> a + b;\n            case '-' -> a - b;\n            case '*' -> a * b;\n            case '/' -> a / b;\n            default -> 0;\n        };\n        System.out.println(result);\n    }\n}\n\n```\n\n# 3\u3001\u5faa\u73af\u8bed\u53e5\n\n## for\u5faa\u73af\n\n```java\nfor(int i=0;i<10;i++){\n    ----------;\n}\n```\n\n\u683c\u5f0f\u4e5f\u8ddfC++\u4e00\u6837\n\n## while\u5faa\u73af\n\n```java\nwhile(\u6761\u4ef6\u5224\u65ad\u8bed\u53e5){\n\u5faa\u73af\u4f53\u8bed\u53e5\n\u6761\u4ef6\u63a7\u5236\u8bed\u53e5\n}\n```\n\n**for\u548cwhile\u7684\u533a\u522b:**\n\n1. for\u5faa\u73af\u4e2d:\u77e5\u9053\u5faa\u73af\u6b21\u6570\u6216\u8005\u5faa\u73af\u7684\u8303\u56f4\n2. while\u5faa\u73af:\u4e0d\u77e5\u9053\u5faa\u73af\u7684\u6b21\u6570\u548c\u8303\u56f4\uff0c\u53ea\u77e5\u9053\u5faa\u73af\u7684\u7ed3\u675f\u6761\u4ef6\u3002", "top": 0, "createdAt": 1785230290, "style": "", "script": "<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script>", "head": "", "ogImage": "https://avatars.githubusercontent.com/u/165184260?v=4&size=64", "createdDate": "2026-07-28", "dateLabelColor": "#1f883d"}, "P4": {"htmlDir": "docs/post/fang-fa-\u3001JAVA-yuan-li-\uff08-hou-xu-mian-xiang-dui-xiang-hui-dan-kai-yi-pian-\uff09.html", "labels": ["documentation"], "postTitle": "\u65b9\u6cd5\u3001JAVA\u539f\u7406\uff08\u540e\u7eed\u9762\u5411\u5bf9\u8c61\u4f1a\u5355\u5f00\u4e00\u7bc7\uff09", "postUrl": "post/fang-fa-%E3%80%81JAVA-yuan-li-%EF%BC%88-hou-xu-mian-xiang-dui-xiang-hui-dan-kai-yi-pian-%EF%BC%89.html", "postSourceUrl": "https://github.com/Whitegveking/Whitegve-king.github.io/issues/4", "commentNum": 0, "wordCount": 1737, "description": "# 1\u3001\u65b9\u6cd5\n\n## \u4ec0\u4e48\u662f\u65b9\u6cd5?\u5e94\u7528\u573a\u666f?\u597d\u5904?\n\n**\u65b9\u6cd5**\uff1a\u7a0b\u5e8f\u4e2d\u7684\u72ec\u7acb\u529f\u80fd\uff0c\u4e5f\u662f\u6700\u5c0f\u7684\u6267\u884c\u5355\u5143\n\n**\u5e94\u7528\u573a\u666f**\uff1a\u7ecf\u5e38\u4f7f\u7528\u7684\u4ee3\u7801\u6253\u5305\uff0c\u653e\u5728\u65b9\u6cd5\u5f53\u4e2d\n\n**\u597d\u5904**\uff1a\u63d0\u9ad8\u4e86\u7a0b\u5e8f\u7684**\u590d\u7528\u6027**\u548c**\u53ef\u7ef4\u62a4\u6027**\n\n## \u65b9\u6cd5\u7684\u683c\u5f0f\u548c\u6267\u884c\u6d41\u7a0b\n\n**\u65b9\u6cd5\u7684\u683c\u5f0f**\n\n```java\npublic static \u8fd4\u56de\u503c\u7c7b\u578b\u65b9\u6cd5\u540d(\u53c2\u65701\uff0c\u53c2\u65702...){\n    \u65b9\u6cd5\u4f53;\n    return \u8fd4\u56de\u503c;\n}\n```\n\n**\u6ce8\u610f\u70b9\uff1a**\n\n1. \u65b9\u6cd5\u4e0e\u65b9\u6cd5\u4e4b\u95f4\u662f\u5e73\u7ea7\u5173\u7cfb\uff0c\u4e0d\u80fd\u4e92\u76f8\u5d4c\u5957\n2. \u65b9\u6cd5\u4e0d\u4f1a\u4e3b\u52a8\u8fd0\u884c\uff0c\u9700\u8981\u88ab\u8c03\u7528\n3. \u5c0f\u62ec\u53f7\u4e2d\u7684\u53c2\u6570\u9700\u8981\uff08\u5f62\u53c2\u548c\u5b9e\u53c2\uff09\u4e00\u4e00\u5bf9\u5e94\uff08\u4e2a\u6570\uff0c\u7c7b\u578b\uff09\n\n**\u65b9\u6cd5\u7684\u6267\u884c\u6d41\u7a0b**\n\n\u5b9e\u53c2\u4f20\u7ed9\u5f62\u53c2\n\n`return`:\u7ed3\u675f\u65b9\u6cd5\uff0c\u5c06\u7ed3\u679c\u8fd4\u56de\u7ed9\u8c03\u7528\u5904\n\n## \u5b9a\u4e49\u65b9\u6cd5\u7684\u5c0f\u8bc0\u7a8d\n\n1. \u89c2\u5bdf\u5728\u5927\u6bb5\u7684\u4ee3\u7801\u5f53\u4e2d\uff0c\u53cd\u590d\u4f7f\u7528\u7684\u72ec\u7acb\u529f\u80fd\u662f\u4ec0\u4e48?\u53cd\u590d\u4f7f\u7528+\u72ec\u7acb\u529f\u80fd\n2. \u8fd9\u4e2a\u72ec\u7acb\u529f\u80fd\uff0c\u9700\u8981\u4ec0\u4e48\u624d\u80fd\u5b8c\u6210?\n3. \u65b9\u6cd5\u7684\u8c03\u7528\u5904\uff0c\u662f\u5426\u9700\u8981\u8fd9\u4e2a\u72ec\u7acb\u529f\u80fd\u7684\u7ed3\u679c\u7ee7\u7eed\u505a\u5176\u4ed6\u4e8b\u60c5?\n\n## \u65b9\u6cd5\u7684\u91cd\u8f7d\n\n1. \u540c\u4e00\u4e2a\u7c7b\u4e2d\uff0c\u5b9a\u4e49\u4e86\u591a\u4e2a\u540c\u540d\u7684\u65b9\u6cd5\uff0c\u8fd9\u4e9b\u65b9\u6cd5\u5177\u6709\u7c7b\u4f3c\u7684\u529f\u80fd\n2. \u6bcf\u4e2a\u65b9\u6cd5\u5177\u6709\u4e0d\u540c\u7684\u53c2\u6570\u7c7b\u578b\u548c\u53c2\u6570\u4e2a\u6570\uff0c\u8fd9\u4e9b\u540c\u540d\u7684\u65b9\u6cd5\uff0c\u5c31\u6784\u6210\u4e86**\u91cd\u8f7d\u5173\u7cfb**\n3. \u7b80\u5355\u7406\u89e3:\u540c\u4e00\u4e2a\u7c7b\uff0c\u65b9\u6cd5\u540d\u76f8\u540c\uff0c\u53c2\u6570\u4e0d\u540c\u7684\u65b9\u6cd5\uff0c\u65e0\u9700\u770b\u8fd4\u56de\u503c\n4. \u65b9\u6cd5\u91cd\u8f7d\u4e00\u822c\u4e0d\u4f1a\u5199\u6210\u5f62\u53c2\u4e0d\u540c\u7684\u5f62\u5f0f\n\n## \u65b9\u6cd5\u7684\u6ce8\u610f\u4e8b\u9879\n\n1. \u65b9\u6cd5\u4e0d\u8c03\u7528\u5c31\u4e0d\u6267\u884c\n2. \u65b9\u6cd5\u4e0e\u65b9\u6cd5\u4e4b\u95f4\u662f\u5e73\u7ea7\u5173\u7cfb\uff0c\u4e0d\u80fd\u5d4c\u5957\u5b9a\u4e49\n3. \u8c03\u7528\u65b9\u6cd5\u4f1a\u4f18\u5148\u8c03\u7528\u5f62\u53c2\u548c\u5b9e\u53c2\u4e00\u4e00\u5bf9\u5e94\u7684\uff0c\u5982\u679c\u6ca1\u6709\u624d\u4f1a\u8fdb\u884c\u9690\u5f0f\u8f6c\u6362\n4. return:1.\u7ed3\u675f\u65b9\u6cd52.\u5c06\u7ed3\u679c\u8fd4\u56de\u7ed9\u8c03\u7528\u8005\n5. void:\u6ca1\u6709\u8fd4\u56de\u503c\uff0c\u53ef\u4ee5\u7701\u7565return\u4e0d\u5199\uff0c\u5982\u679c\u4e0d\u7701\u7565\uff0creturn\u540e\u9762\u4e0d\u80fd\u5199\u5177\u4f53\u6570\u636e\uff0c\u4ec5\u8868\u793a\u7ed3\u675f\u65b9\u6cd5\n\n# 2\u3001JAVA\u539f\u7406\n\n## JAVA\u7684\u8fd0\u884c\u673a\u5236\n\n`.java`\u6587\u4ef6\u7f16\u8bd1\u6210`class`\u6587\u4ef6\u540e\u8fd0\u884c\u5728JVM\uff08java\u865a\u62df\u673a\uff09\u4e2d\n\n1. **Java\u7a0b\u5e8f\u8fd0\u884c\u7684\u8fc7\u7a0b\u662f\u600e\u4e48\u6837\u7684?** Java\u6587\u4ef6-->class\u5b57\u8282\u7801\u6587\u4ef6-->\u7ed3\u679c\n2. **Java\u662f\u76f4\u63a5\u8fd0\u884c\u5728\u64cd\u4f5c\u7cfb\u7edf\u91cc\u9762\u7684\u5417?** \u4e0d\u662f\uff0c\u662f\u8fd0\u884c\u5728\u865a\u62df\u673a\u91cc\u9762\u7684\n3. **\u865a\u62df\u673a\u7684\u597d\u5904\u662f\u4ec0\u4e48?** \u5229\u7528\u865a\u62df\u673a\u53ef\u4ee5\u5b9e\u73b0\u8de8\u5e73\u53f0\n4. **\u4e3a\u4ec0\u4e48\u8981\u8de8\u5e73\u53f0? \u5199\u4e00\u5957\u4ee3\u7801\uff0c**\u53ef\u4ee5\u5728\u4efb\u610f\u7684\u64cd\u4f5c\u7cfb\u7edf\u4e2d\u8fd0\u884c\n\n## JAVA\u7684\u5185\u5b58\u7ba1\u7406\n\n**\u5185\u5b58**\uff1a\u8f6f\u4ef6\u5728\u8fd0\u884c\u65f6\uff0c\u7528\u6765\u4e34\u65f6\u5b58\u50a8\u6570\u636e\u7684\n\n**\u5185\u5b58\u5730\u5740**\uff1a\u4e00\u4e2a\u7f16\u53f7\uff0c\u7528\u6765\u5feb\u901f\u67e5\u627e\u5185\u5b58\u4e2d\u7684\u6570\u636e\uff0c\u4ece\u800c\u5feb\u901f\u5730\u7ba1\u7406\u5185\u5b58\u7a7a\u95f4\n\n## JAVA\u4e2d\u7684\u5185\u5b58\u5206\u914d\n\n1. \u6808\u5185\u5b58\uff1a\u65b9\u6cd5\t\n2. \u5806\u5185\u5b58\uff1anew\u5173\u952e\u5b57\n3. \u65b9\u6cd5\u533a\uff1a\u5b57\u8282\u7801\u4fe1\u606f\uff08class\uff09;JDK7\u6c38\u4e45\u4ee3\u5b9e\u73b0\uff0cJDK8+\u5143\u7a7a\u95f4\u5b9e\u73b0\uff0c\u4ece\u865a\u62df\u673a\u5185\u90e8\u79fb\u5230\u672c\u5730\u5185\u5b58\u3002", "top": 0, "createdAt": 1785308664, "style": "", "script": "<script src='https://blog.meekdai.com/Gmeek/plugins/GmeekTOC.js'></script>", "head": "", "ogImage": "https://avatars.githubusercontent.com/u/165184260?v=4&size=64", "createdDate": "2026-07-29", "dateLabelColor": "#1f883d"}}, "singeListJson": {}, "labelColorDict": {"bug": "#d73a4a", "documentation": "#0075ca", "duplicate": "#cfd3d7", "enhancement": "#a2eeef", "good first issue": "#7057ff", "help wanted": "#008672", "invalid": "#e4e669", "question": "#d876e3", "wontfix": "#ffffff"}, "displayTitle": "Cyy\u7684JAVA\u5b66\u4e60\u65e5\u8bb0", "faviconUrl": "https://avatars.githubusercontent.com/u/165184260?v=4&size=64", "ogImage": "https://avatars.githubusercontent.com/u/165184260?v=4&size=64", "primerCSS": "<link href='https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/Primer/21.0.7/primer.css' rel='stylesheet' />", "homeUrl": "https://Whitegveking.github.io/Whitegve-king.github.io", "prevUrl": "disabled", "nextUrl": "disabled"}